# ====================================================================================
# ARCHIVO DE CONFIGURACIÓN DE EJEMPLO - SISTEMA API PROVEEDORES
# ====================================================================================
# 
# Este es un archivo de plantilla. Copiar como .env y configurar los valores reales.
# ¡NUNCA subir el archivo .env real al repositorio!
# 

# ====================================================================================
# CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# ====================================================================================

APP_NAME="GestionPlus"
APP_ENV=local
APP_DEBUG=true
APP_KEY=base64:GENERAR_CON_php_artisan_key_generate
# Local: puerto 8088 (evita choque con 80/8000)
APP_URL=http://localhost:8088
APP_FRONTEND_URL=http://localhost:4300

# Configuración de zona horaria y locale para Los Mochis, Sinaloa, México
APP_TIMEZONE=America/Mazatlan
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

# ====================================================================================
# CONFIGURACIÓN DE BASE DE DATOS
# ====================================================================================

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=proveedores_api
DB_USERNAME=tu_usuario_db
DB_PASSWORD=tu_password_db
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ====================================================================================
# CONFIGURACIÓN DE SEGURIDAD
# ====================================================================================

# Clave de API para registro y operaciones sensibles
API_REGISTRATION_KEY=tu_clave_api_super_secreta

# ====================================================================================
# CONFIGURACIÓN DE CACHE Y SESIONES
# ====================================================================================

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ====================================================================================
# CONFIGURACIÓN DE LOGS
# ====================================================================================

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ====================================================================================
# CONFIGURACIÓN DE CORREO ELECTRÓNICO
# ====================================================================================

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_email@gmail.com
MAIL_PASSWORD=tu_password_email
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@tu-dominio.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_CONTACT_RECIPIENTS="contacto@tu-dominio.com,soporte@tu-dominio.com"

# ====================================================================================
# CONFIGURACIÓN DE REDIS (OPCIONAL)
# ====================================================================================

# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ====================================================================================
# CONFIGURACIÓN DE AWS S3 (OPCIONAL)
# ====================================================================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ====================================================================================
# CONFIGURACIÓN DE PUSHER (OPCIONAL)
# ====================================================================================

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# ====================================================================================
# CONFIGURACIÓN DE VITE (FRONTEND)
# ====================================================================================

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ====================================================================================
# INTERCOMUNICACIÓN CON API CONSTRUCCIONES
# ====================================================================================

API_CONSTRUCCIONES_URL=http://localhost:8091
API_CONSTRUCCIONES_APIKEY=tu_clave_super_secreta_para_construcciones

# ====================================================================================
# FIREBASE CLOUD MESSAGING (API v1) — PUSH DESDE EL BACKEND
# ====================================================================================
# Descarga la cuenta de servicio (JSON) desde:
# Firebase Console → Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada
# Guárdala como: storage/app/firebase/service-account.json
# (ruta relativa a storage/; el valor por defecto ya es correcto)
#
# FIREBASE_CREDENTIALS=app/firebase/service-account.json
# FCM_PROJECT_ID=app-proveedores-notificacion
# FCM_SENDER_ID=989092385974

# ====================================================================================
# OAUTH / SOCIALITE (login social PWA)
# ====================================================================================
# Docs: docs/context/platform-auth-socialite.md
# Redirect URI = APP_URL + /api/auth/{provider}/callback (debe coincidir en Google Cloud)
# Local típico: http://localhost:8088/api/auth/google/callback
OAUTH_PROVIDERS=google
# OAUTH_FRONTEND_CALLBACK=http://localhost:4300/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

# ====================================================================================
# LARAVEL PULSE
# ====================================================================================
PULSE_ENABLED=true
PULSE_PATH=pulse
PULSE_STORAGE_DRIVER=database