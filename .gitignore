# ====================================================================================
# CONFIGURACIÓN GITIGNORE PARA LARAVEL API - SISTEMA PROVEEDORES
# ====================================================================================

# ====================================================================================
# LARAVEL FRAMEWORK
# ====================================================================================

# Archivos de entorno (NUNCA subir al repositorio)
.env
.env.*
!.env.example
.env.backup
.env.production
.env.local
.env.testing

# Dependencias
/vendor/
/node_modules/
composer.phar
package-lock.json
yarn.lock

# Archivos de compilación y cache
/public/hot
/public/storage
/public/build
/public/mix-manifest.json
/bootstrap/cache/*.php
/bootstrap/compiled.php
/storage/app/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*

# Mantener directorios importantes pero vacíos
!/storage/app/.gitkeep
!/storage/app/public/.gitkeep
# Firebase Admin SDK: carpeta versionada; la clave JSON no se sube (ver abajo)
!/storage/app/firebase/
!/storage/app/firebase/.gitkeep
!/storage/framework/cache/.gitkeep
!/storage/framework/sessions/.gitkeep
!/storage/framework/testing/.gitkeep
!/storage/framework/views/.gitkeep
!/storage/logs/.gitkeep

# Cache de configuración y rutas
.phpunit.result.cache
phpunit.xml
!phpunit.xml.dist

# Laravel Homestead
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log

# Laravel Telescope (si se usa)
telescope.json

# Laravel IDE Helper
_ide_helper.php
_ide_helper_models.php
.phpstorm.meta.php

# ====================================================================================
# BASES DE DATOS
# ====================================================================================

# Base de datos SQLite
*.sqlite
*.sqlite3
*.db

# Respaldos de base de datos
*.sql
*.dump
database/backups/

# ====================================================================================
# LOGS Y ARCHIVOS TEMPORALES
# ====================================================================================

# Logs específicos del proyecto
storage/logs/*.log
storage/logs/*.txt
*.log

# Archivos temporales
*.tmp
*.temp
*.swp
*.swo
*~

# Archivos de depuración
debug.log
error.log
xdebug.log

# ====================================================================================
# ARCHIVOS SENSIBLES Y CONFIGURACIÓN
# ====================================================================================

# Firebase Cloud Messaging (Laravel) — credencial de cuenta de servicio (nunca en git)
/storage/app/firebase/service-account.json

# Claves y certificados
*.pem
*.key
*.crt
*.p12
*.pfx
ssl/
certificates/

# Archivos de configuración sensibles
config/local.php
config/production.php
config/staging.php

# Documentación privada
/docs/private/
/docs/internal/

# ====================================================================================
# ARCHIVOS DE UPLOADS Y MEDIOS
# ====================================================================================

# Directorio de uploads (ajustar según necesidades)
/public/uploads/*
!/public/uploads/.gitkeep

# Archivos de imagen temporales
/storage/app/temp/*
/storage/app/uploads/*
!/storage/app/uploads/.gitkeep

# ====================================================================================
# HERRAMIENTAS DE DESARROLLO Y EDITORES
# ====================================================================================

# PhpStorm / IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
atlassian-ide-plugin.xml

# Visual Studio Code
# .vscode/
*.code-workspace

# Sublime Text
*.sublime-project
*.sublime-workspace
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
sftp-config.json

# Vim
*.swp
*.swo
*.un~
Session.vim
.netrwhist

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp

# ====================================================================================
# SISTEMAS OPERATIVOS
# ====================================================================================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ====================================================================================
# HERRAMIENTAS DE BUILD Y ASSETS
# ====================================================================================

# Laravel Mix
/public/css/
/public/js/
!/public/css/.gitkeep
!/public/js/.gitkeep

# Sass
.sass-cache/
*.css.map
*.sass.map
*.scss.map

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Bower
bower_components/
.bower-cache
.bower-registry
.bower-tmp

# ====================================================================================
# TESTING Y COVERAGE
# ====================================================================================

# PHPUnit
.phpunit.result.cache
/coverage/
/coverage.xml
phpunit.xml
!phpunit.xml.dist

# Codeception
/tests/_output/
/tests/_support/_generated/

# ====================================================================================
# ESPECÍFICOS DEL PROYECTO API PROVEEDORES
# ====================================================================================

# Documentación de API generada
/public/docs/
/storage/api-docs/

# Archivos de importación/exportación temporales
/storage/imports/
/storage/exports/
/storage/temp/

# Reportes generados
/storage/reports/

# Archivos de respaldo específicos
backup_*.sql
respaldo_*.zip

# ====================================================================================
# CACHE Y PERFORMANCE
# ====================================================================================

# Cache de aplicaciones
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitkeep

# Archivos de sesión
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep

# Vistas compiladas
/storage/framework/views/*
!/storage/framework/views/.gitkeep
routes/segmented/construcc.php
storage/logs/*.*
/public/uploads/*
!/public/uploads/.gitkeep
# public/storage debe ser SOLO el symlink de `php artisan storage:link`.
# No versionar carpeta ni .gitkeep ahí (rompe el link en cada deploy/pull).
postman.json
