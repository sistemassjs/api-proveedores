}

### 4.4 Completar Registro de Proveedor tipo_alta=2
# Cambia tipo_alta de 2 a 1, crea usuario, retorna token
POST {{baseUrl}}/auth/completar-registro-proveedor
X-API-KEY: {{apiKey}}
Content-Type: application/json

{
  "proveedor_id": 1,
  "token_temporal": "eyJwcm92ZWVkb3JfaWQiOjEsInRpbWVzdGFtcCI6MTcwNTI1MDAwMH0=",
  "password": "nuevaPassword123",
  "password_confirmation": "nuevaPassword123",
  "razon_social": "Constructora Ejemplo Actualizada SA de CV",
  "email": "nuevo@constructoraejemplo.com",
  "telefono": "5512345679"
}

###############################################################################
# 5. NOTAS DE USO
###############################################################################

# NIVELES DE USUARIO (nivel_id):
# 0 - Admin (Requiere aprobación como residente)
# 1 - DG (Director General) → Auto-aprueba SPP → estado: AUTORIZADA
# 2 - DT (Director Técnico) → Auto-aprueba SPP → estado: AUTORIZADA  
# 3 - DA (Director Administrativo) → Directo a pago → estado: AUTORIZADA + da/pc marcados
# 4 - SI (Superintendente) → Solo verifica
# 5 - PC (Programación y Control) → Auto-aprueba SPP → estado: AUTORIZADA
# 6 - RO (Residente de Obra) → Requiere aprobación → estado: PENDIENTE
# 7 - Requiere aprobación → estado: PENDIENTE

# VALIDACIONES IMPORTANTES:
# - tipo_alta = 2: Solo proveedores de construcción
# - Campos únicos: RFC, email, telefono
# - Primera cuenta bancaria es automáticamente preferida
# - No se puede eliminar la única cuenta de un proveedor
# - No se puede eliminar cuenta con SPP asociadas
# - Solo directores (1,2,3,5) o creador pueden actualizar/eliminar proveedores
# - nivel_id es REQUERIDO en ConstruccProveedorGenerarSppRequest
# - nivel_id es NULLABLE en ConstruccProveedorStoreRequest
# - Campos adicionales en SPP: obra_id, tipo, tipo_id, notas, utilizara, equipo, equipo_id (todos nullable)
# 
# ARCHIVOS EN SPP (Validación Condicional):
# - Si se adjunta COTIZACIÓN → Factura PDF y XML son OPCIONALES
# - Si NO se adjunta COTIZACIÓN → Factura PDF y XML son OBLIGATORIAS
# - Mínimo debe haber: Factura (PDF+XML) O Cotización

# CÓDIGOS DE RESPUESTA:
# 200 - OK (GET, PUT exitosos / Info proveedor existente tipo_alta=2)
# 201 - Created (POST exitosos)
# 403 - Forbidden (Sin permisos, tipo_alta incorrecto)
# 404 - Not Found (Recurso no encontrado)
# 409 - Conflict (RFC/email/telefono duplicado con tipo_alta=1)
# 422 - Unprocessable Entity (Validación fallida, restricciones)
# 500 - Internal Server Error

###############################################################################
# 6. EJEMPLOS DE RESPUESTAS
###############################################################################

