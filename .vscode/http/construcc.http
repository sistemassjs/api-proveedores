# ARCHIVO DE PRUEBAS HTTP - CONSTRUCC
# API Solicitudes de Pago - Los Mochis, Sinaloa, México
###

# @baseUrl = http://localhost:80/api
# @baseUrl = https://apicons.ddns.net:8092/api
@baseUrl = https://api.rorisafe.com/gestion/api
@contentType = application/json
@acceptType = application/json
@apiKey = 7f2wnCyn7ctmTE7B3mrtDPKCPVF9z8pYseihsHA6

### VARIABLES
@solicitudId = 568
@rol = DG


https://apicons.ddns.net:8092/api/construcc/solicitudes-pago?estado_solicitud=rechazada&proveedor_id=1
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}


### 

GET http://localhost:8080/api/construcc/solicitudes-pago/empresa/14/proveedores
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}


###############################################################################
# RUTAS CONSTRUCC - SOLICITUDES DE PAGO
###############################################################################

### 1. Listado general de solicitudes de pago
GET {{baseUrl}}/construcc/solicitudes-pago
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}

### 🆕 1.1. Buscar solicitud de pago por folio
GET {{baseUrl}}/construcc/solicitudes-pago/568
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}

### 2. Ver detalle de solicitud específica
GET {{baseUrl}}/construcc/solicitudes-pago/{{solicitudId}}
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}

### 3. Descargar comprobante de pago
GET {{baseUrl}}/construcc/solicitudes-pago/{{solicitudId}}/comprobante/download
X-API-KEY: {{apiKey}}

### 4. Descargar factura PDF
GET {{baseUrl}}/construcc/solicitudes-pago/{{solicitudId}}/factura-pdf/download
X-API-KEY: {{apiKey}}

### 5. Descargar factura XML
GET {{baseUrl}}/construcc/solicitudes-pago/{{solicitudId}}/factura-xml/download
X-API-KEY: {{apiKey}}

### 6. Descargar cotización
GET {{baseUrl}}/construcc/solicitudes-pago/{{solicitudId}}/cotizacion/download
X-API-KEY: {{apiKey}}



###############################################################################
# CAMBIOS DE ESTATUS - CONSTRUCC
###############################################################################

### 7. Autorizar solicitud de pago (por rol)
POST {{baseUrl}}/construcc/solicitudes-pago/175/autorizar
X-API-KEY: {{apiKey}}
Content-Type: {{contentType}}

{
  "rol": "{{rol}}"
}

### 8. Rechazar solicitud de pago
POST {{baseUrl}}/construcc/solicitudes-pago/{{solicitudId}}/rechazar
X-API-KEY: {{apiKey}}
Content-Type: {{contentType}}

{
  "rol": "DT",
  "motivo_rechazo": "El monto no corresponde con la cotización original."
}

### 9. Confirmar pago (solo DA)
POST {{baseUrl}}/construcc/solicitudes-pago/{{solicitudId}}/confirmar-pago
X-API-KEY: {{apiKey}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="comprobante"; filename="comprobante_pago.pdf"
Content-Type: application/pdf

< ./tests/files/comprobante_pago.pdf
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="monto_abono"

50000.00
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="notas_abono"

Pago parcial correspondiente a avance de obra del 50%.
------WebKitFormBoundary7MA4YWxkTrZu0gW--



###############################################################################
# LISTADOS POR ROL Y ESTADO
###############################################################################

### 10. Listar solicitudes pendientes por rol (DG, DT, CO, SI, DA)
GET {{baseUrl}}/construcc/solicitudes-pago/por-rol?rol=DT
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}

### 11. Listar solicitudes por estado (PENDIENTE, AUTORIZADA, RECHAZADA, PAGADO)
GET {{baseUrl}}/construcc/solicitudes-pago/por-estado?estado=AUTORIZADA
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}



###############################################################################
# DASHBOARD Y AUXILIARES
###############################################################################

### 12. Estadísticas por rol
GET {{baseUrl}}/construcc/solicitudes-pago/estadisticas-rol?rol=DA
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}

### 13. Buscar empresas constructoras
GET {{baseUrl}}/construcc/solicitudes-pago/empresas-constructoras/search?search=construcciones&limit=10
X-API-KEY: {{apiKey}}

### 14. Estadísticas generales
GET {{baseUrl}}/construcc/solicitudes-pago/estadisticas
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}



###############################################################################
# GESTIÓN DE PROVEEDORES POR EMPRESA - NUEVOS ENDPOINTS
###############################################################################

### VARIABLES PARA PRUEBAS DE PROVEEDORES
@empresaId = 14
@proveedorId = 1
@usuarioId = 1234

### 15. Listar proveedores asociados a una empresa constructora
GET {{baseUrl}}/construcc/solicitudes-pago/empresa/{{empresaId}}/proveedores
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}

### 16. 🆕 Listar proveedores NO asociados a una empresa constructora
GET {{baseUrl}}/construcc/solicitudes-pago/empresa/{{empresaId}}/proveedores/no-asociados
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}

### 16.1 🆕 Métricas dashboard SP - VERIFICADAS
GET {{baseUrl}}/construcc/solicitudes-pago/dashboard-sp-metricas/verificadas?usuario_id={{usuarioId}}&empresa_id={{empresaId}}&proveedor_id={{proveedorId}}&fecha_registro_pendiente_desde=2024-01-01&fecha_registro_pendiente_hasta=2024-12-31
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}

### 16.2 🆕 Métricas dashboard SP - NO VERIFICADAS
GET {{baseUrl}}/construcc/solicitudes-pago/dashboard-sp-metricas/no-verificadas?usuario_id={{usuarioId}}&empresa_id={{empresaId}}&proveedor_id={{proveedorId}}&fecha_registro_pendiente_desde=2024-01-01&fecha_registro_pendiente_hasta=2024-12-31
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}

### 17. 🆕 Asociar un proveedor a una empresa constructora
POST {{baseUrl}}/construcc/solicitudes-pago/empresa/{{empresaId}}/proveedores/asociar
X-API-KEY: {{apiKey}}
Content-Type: {{contentType}}

{
  "proveedor_id": {{proveedorId}}
}

### 18. Prueba con empresa diferente (ID 1)
GET {{baseUrl}}/construcc/solicitudes-pago/empresa/1/proveedores/no-asociados
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}

### 19. Asociar múltiples proveedores (cambiar proveedorId)
POST {{baseUrl}}/construcc/solicitudes-pago/empresa/1/proveedores/asociar
X-API-KEY: {{apiKey}}
Content-Type: {{contentType}}

{
  "proveedor_id": 2
}

### 20. Verificar asociación (debería mostrar el proveedor asociado)
GET {{baseUrl}}/construcc/solicitudes-pago/empresa/1/proveedores
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}



###############################################################################
# CASOS DE ERROR - NUEVOS ENDPOINTS
###############################################################################

### 21. Error: Empresa que no existe
GET {{baseUrl}}/construcc/solicitudes-pago/empresa/999999/proveedores/no-asociados
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}

### 22. Error: Proveedor que no existe
POST {{baseUrl}}/construcc/solicitudes-pago/empresa/{{empresaId}}/proveedores/asociar
X-API-KEY: {{apiKey}}
Content-Type: {{contentType}}

{
  "proveedor_id": 999999
}

### 23. Error: Parámetro faltante
POST {{baseUrl}}/construcc/solicitudes-pago/empresa/{{empresaId}}/proveedores/asociar
X-API-KEY: {{apiKey}}
Content-Type: {{contentType}}

{
  "proveedor_id": ""
}

### 24. Error: Intentar asociar el mismo proveedor dos veces (409 Conflict)
POST {{baseUrl}}/construcc/solicitudes-pago/empresa/{{empresaId}}/proveedores/asociar
X-API-KEY: {{apiKey}}
Content-Type: {{contentType}}

{
  "proveedor_id": {{proveedorId}}
}
