###
# ARCHIVO DE PRUEBAS HTTP - CONSTRUCC
# API Pagos SPP - Los Mochis, Sinaloa, México
###

@baseUrl = http://localhost:80/api
# @baseUrl = https://apicons.ddns.net:8092/api
@contentType = application/json
@acceptType = application/json
@apiKey = 7f2wnCyn7ctmTE7B3mrtDPKCPVF9z8pYseihsHA6

### VARIABLES
@pagoId = 1
@proveedorId = 8
@sppId = 1

###############################################################################
# RUTAS CONSTRUCC - PAGOS SPP
###############################################################################

### 1. Listado general de pagos SPP
GET {{baseUrl}}/construcc/pagos-spp
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}

### 2. Ver detalle de un pago SPP por ID
GET {{baseUrl}}/construcc/pagos-spp/{{pagoId}}
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}

###############################################################################
# FILTROS POR PROVEEDOR Y SPP
###############################################################################

### 3. Listar pagos SPP por proveedor (todas sus SPP)
GET {{baseUrl}}/construcc/pagos-spp/proveedor
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}

### 4. Listar SPP de un proveedor
GET {{baseUrl}}/construcc/pagos-spp/proveedor/{{proveedorId}}/spp
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}

### 5. Listar pagos aplicados a una SPP específica de un proveedor
GET {{baseUrl}}/construcc/pagos-spp/proveedor/{{proveedorId}}/spp/{{sppId}}/pagos
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}

###############################################################################
# REGISTRO DE PAGOS
###############################################################################

### 6. Registrar un nuevo pago SPP a un proveedor
POST {{baseUrl}}/construcc/pagos-spp/proveedor/{{proveedorId}}/pagos
X-API-KEY: {{apiKey}}
Content-Type: {{contentType}}
Accept: {{acceptType}}

{
  "spp_id": {{sppId}},
  "monto_pagado": 15000.50,
  "fecha_pago": "2026-02-07",
  "metodo_pago": "TRANSFERENCIA",
  "referencia": "TRX-00012345",
  "notas": "Pago parcial correspondiente al anticipo de la SPP."
}

###############################################################################
# CASOS DE ERROR
###############################################################################

### 7. Error: Proveedor inexistente
GET {{baseUrl}}/construcc/pagos-spp/proveedor/999999/spp
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}

### 8. Error: SPP inexistente para proveedor
GET {{baseUrl}}/construcc/pagos-spp/proveedor/{{proveedorId}}/spp/999999/pagos
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}

### 9. Error: Registrar pago con monto inválido
POST {{baseUrl}}/construcc/pagos-spp/proveedor/{{proveedorId}}/pagos
X-API-KEY: {{apiKey}}
Content-Type: {{contentType}}
Accept: {{acceptType}}

{
  "spp_id": {{sppId}},
  "monto_pagado": 0,
  "fecha_pago": "2026-02-07"
}

###############################################################################
# FLUJOS DE PRUEBA
###############################################################################

### 10. Flujo completo: 
# Paso 1: Listar SPP del proveedor
GET {{baseUrl}}/construcc/pagos-spp/proveedor/{{proveedorId}}/spp
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}

### Paso 2: Elegir una SPP y ver sus pagos
GET {{baseUrl}}/construcc/pagos-spp/proveedor/{{proveedorId}}/spp/{{sppId}}/pagos
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}

### Paso 3: Registrar un nuevo pago
POST {{baseUrl}}/construcc/pagos-spp/proveedor/{{proveedorId}}/pagos
X-API-KEY: {{apiKey}}
Content-Type: {{contentType}}
Accept: {{acceptType}}

{
  "spp_id": {{sppId}},
  "monto_pagado": 5000.00,
  "fecha_pago": "2026-02-07",
  "metodo_pago": "EFECTIVO",
  "referencia": "PAGO-CAJA-01",
  "notas": "Abono adicional para reducir saldo pendiente."
}

###############################################################################
# PAGOS DIRECTOS (sin SPP / sin aprobación)
###############################################################################

### 11. Registrar pago directo (multipart: comprobante + facturas opcionales)
# Content-Type: multipart/form-data
POST {{baseUrl}}/construcc/pagos-spp/proveedor/{{proveedorId}}/pagos-directos
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="comprobante_pago"; filename="comprobante.pdf"
Content-Type: application/pdf

< ./tests/files/comprobante.pdf
--boundary
Content-Disposition: form-data; name="empresa_id"

1
--boundary
Content-Disposition: form-data; name="proveedor_id"

{{proveedorId}}
--boundary
Content-Disposition: form-data; name="usuario_id"

10
--boundary
Content-Disposition: form-data; name="usuario_nombre"

Usuario Construcc
--boundary
Content-Disposition: form-data; name="monto_total"

15000.50
--boundary
Content-Disposition: form-data; name="info_comprobante[fecha]"

2026-09-10
--boundary
Content-Disposition: form-data; name="info_comprobante[hora]"

12:00:00
--boundary
Content-Disposition: form-data; name="info_comprobante[referencia]"

TRX-DIRECTO-001
--boundary
Content-Disposition: form-data; name="facturas[0][folio_factura]"

F-1001
--boundary
Content-Disposition: form-data; name="facturas[0][metodo_pago]"

PPD
--boundary
Content-Disposition: form-data; name="facturas[0][factura_pdf]"; filename="factura.pdf"
Content-Type: application/pdf

< ./tests/files/comprobante.pdf
--boundary--

### 12. Agregar factura a un pago existente
# @pagoDirectoId = 1
POST {{baseUrl}}/construcc/pagos-spp/pagos/{{pagoId}}/facturas
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="folio_factura"

F-1002
--boundary
Content-Disposition: form-data; name="metodo_pago"

PUE
--boundary
Content-Disposition: form-data; name="factura_pdf"; filename="factura.pdf"
Content-Type: application/pdf

< ./tests/files/comprobante.pdf
--boundary--

### 13. Agregar complemento a una factura del pago
# @facturaId = 1
POST {{baseUrl}}/construcc/pagos-spp/pagos/{{pagoId}}/facturas/1/complementos
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="folio_complemento"

CP-1
--boundary
Content-Disposition: form-data; name="complemento_pdf"; filename="complemento.pdf"
Content-Type: application/pdf

< ./tests/files/comprobante.pdf
--boundary--

### 14. Reporte contabilidad (incluye pagos directos y documentos_faltantes)
GET {{baseUrl}}/construcc/reportes/contabilidad?fecha_pago_desde=2026-09-01&fecha_pago_hasta=2026-09-30
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}

### 15. Reporte solo pagos directos
GET {{baseUrl}}/construcc/reportes/contabilidad?origen=directo&fecha_pago_desde=2026-09-01&fecha_pago_hasta=2026-09-30
X-API-KEY: {{apiKey}}
Accept: {{acceptType}}
