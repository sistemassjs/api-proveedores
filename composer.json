{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "anhskohbo/no-captcha": "^3.7",
        "bacon/bacon-qr-code": "3.0",
        "barryvdh/laravel-dompdf": "^3.1",
        "carbon-cli/carbon-cli": "^1.3",
        "darkaonline/l5-swagger": "^9.0",
        "doctrine/dbal": "^4.3",
        "laravel/framework": "^12.0",
        "laravel/pulse": "^1.7",
        "laravel/reverb": "^1.6",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.29",
        "laravel/tinker": "^2.10.1",
        "livewire/livewire": "3.6.4",
        "maatwebsite/excel": "^1.1",
        "phpoffice/phpspreadsheet": "^5.9",
        "predis/predis": "^2.0",
        "pusher/pusher-php-server": "^7.2",
        "setasign/fpdf": "^1.8.6",
        "setasign/fpdi": "2.6",
        "smalot/pdfparser": "^2.12",
        "spatie/laravel-query-builder": "^6.3",
        "spatie/pdf-to-text": "^1.54",
        "twilio/sdk": "^8.8",
        "tymon/jwt-auth": "^2.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74,#34d399\" \"php artisan serve --host 0.0.0.0 --port 8088\" \"php artisan queue:work  --queue=imports,notifications,default --sleep=3 --tries=3\" \"powershell -Command 'Get-Content -Path ./storage/logs/laravel.log -Wait -Tail 10'\" \"npm run dev\" \"php artisan reverb:start\" --names=server,queue,logs,vite,reverb"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
